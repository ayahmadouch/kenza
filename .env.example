# ============ LLM (endpoint OpenAI-compatible fourni par Numeos) ============
# Copiez ce fichier en .env puis renseignez VOTRE clé. Ne commitez JAMAIS .env.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optionnel : modèle de transcription (endpoint /audio/transcriptions)
STT_MODEL=
# Optionnel : ne définir que si le modèle accepte le paramètre temperature (gpt-5.x le refuse)
# LLM_TEMPERATURE=
# Reformulation LLM des relances (vérifiée par garde-fou, repli sur gabarit). 0 = gabarits seuls
RELANCE_LLM=

# ============ PostgreSQL / Redis (valeurs Docker par défaut) ============
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Utilisé par les scripts lancés depuis l'hôte (docker-compose le surcharge pour api/worker)
DATABASE_URL=
REDIS_URL=

# ============ Ports ============
API_PORT=
WEB_PORT=

# ============ Relances / démo ============
# Seuil « panier abandonné » : 24 h en production, 1 min pour la démo (même logique métier)
DEMO_DELAY_MINUTES=
# Démo hors horaires boutique uniquement : 1 = ignore 10h-20h lun→sam (laisser 0 en conditions réelles)
DEMO_IGNORE_SHOP_HOURS=
SHOP_TZ=
SHOP_OPEN_HOUR=
SHOP_CLOSE_HOUR=

# ============ Règles métier ============
DISCOUNT_MAX_PCT=
